generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailAuthType {
  password
  oauth
}

model EmailAccount {
  id                    String        @id @default(cuid())
  label                 String
  host                  String
  port                  Int
  username              String
  authType              EmailAuthType @default(password)
  encryptedPassword     String?
  encryptedRefreshToken String?
  needsReauth           Boolean       @default(false)
  secure                Boolean       @default(true)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  syncStates     SyncState[]
  rawEmails      RawEmail[]
  emailMessages  EmailMessage[]
  mailboxActions MailboxAction[]
}

model SyncState {
  id            String     @id @default(cuid())
  accountId     String
  mailbox       String
  lastSyncedUid Int        @default(0)
  lastSyncedAt  DateTime?
  status        SyncStatus @default(IDLE)

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, mailbox])
}

model RawEmail {
  id           String   @id @default(cuid())
  accountId    String
  mailbox      String
  uid          Int
  rawSource    Bytes
  internalDate DateTime
  flags        String[]
  /// IMAP UIDVALIDITY of `mailbox` at fetch time, as a decimal string
  /// (unsigned 32-bit: overflows Int; BigInt breaks JSON serialization).
  /// Null for rows ingested before this column existed.
  uidValidity  String?
  createdAt    DateTime @default(now())

  account        EmailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parsed         ParsedEmail?
  mailboxActions MailboxAction[]

  @@unique([accountId, mailbox, uid])
}

model ParsedEmail {
  id              String   @id @default(cuid())
  rawEmailId      String   @unique
  subject         String?
  fromAddress     String?
  fromName        String?
  toAddresses     Json
  ccAddresses     Json
  textBody        String?
  htmlBody        String?
  attachmentCount Int      @default(0)
  hasUnsubscribe  Boolean  @default(false)
  parsedAt        DateTime @default(now())

  rawEmail   RawEmail         @relation(fields: [rawEmailId], references: [id], onDelete: Cascade)
  normalized NormalizedEmail?
}

model NormalizedEmail {
  id              String   @id @default(cuid())
  parsedEmailId   String   @unique
  senderDomain    String
  isNewsletter    Boolean  @default(false)
  isBulk          Boolean  @default(false)
  tags            String[]
  cleanedText     String?
  detectedLinks   Json     @default("[]")
  unsubscribeLink String?
  normalizedAt    DateTime @default(now())

  // Rule-based classification
  ruleCategory   String?
  ruleConfidence String?
  ruleReasons    String[]

  parsedEmail             ParsedEmail              @relation(fields: [parsedEmailId], references: [id], onDelete: Cascade)
  classification          EmailClassification?
  classificationRevisions ClassificationRevision[]

  @@index([ruleCategory])
  @@index([ruleConfidence])
}

model EmailClassification {
  id                  String   @id @default(cuid())
  normalizedEmailId   String   @unique
  category            String
  importance          String
  urgency             String
  recommendedAction   String
  confidence          String
  needsReview         Boolean  @default(true)
  reason              String
  rawResponse         String?
  classificationError String?
  providerUsed        String?
  senderRuleId        String?
  createdAt           DateTime @default(now())

  normalizedEmail NormalizedEmail @relation(fields: [normalizedEmailId], references: [id], onDelete: Cascade)
  reviewDecision  ReviewDecision?
  // Set when a sender rule classified the email (providerUsed "sender-rule").
  // SetNull keeps the classification row if the rule is deleted.
  senderRule      SenderRule?     @relation(fields: [senderRuleId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([needsReview])
  @@index([confidence])
  @@index([createdAt])
  @@index([senderRuleId])
  @@index([providerUsed])
}

enum SenderRuleMatchType {
  address
  domain
  domain_suffix
  glob
  regex
}

enum SenderRuleAction {
  classify
  trash
}

/// User-defined sender rule. Matched in the classify step before any AI
/// call; a match writes the classification directly.
model SenderRule {
  id        String              @id @default(cuid())
  /// Lowercased for every matchType except regex (matched with flag i).
  pattern   String
  matchType SenderRuleMatchType
  action    SenderRuleAction    @default(classify)
  category  String
  enabled   Boolean             @default(true)
  note      String?
  /// manual | suggestion | tui
  source    String              @default("manual")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  classifications         EmailClassification[]
  mailboxActions          MailboxAction[]
  classificationRevisions ClassificationRevision[]

  @@unique([matchType, pattern])
  @@index([enabled])
}

enum MailboxActionType {
  move_to_trash
  restore
}

enum MailboxActionStatus {
  pending
  succeeded
  failed
  skipped
  undone
  /// The IMAP outcome could not be established (response lost and the
  /// re-check failed). Never retried; resolved by POST /mailbox-actions/reconcile.
  unknown
}

/// Audit log of every IMAP mailbox mutation. A row is written (pending)
/// BEFORE the IMAP MOVE and updated after it. Dry-runs write no rows.
model MailboxAction {
  id                String              @id @default(cuid())
  action            MailboxActionType
  status            MailboxActionStatus
  accountId         String
  /// SetNull keeps the audit row if the RawEmail is later removed.
  rawEmailId        String?
  /// SetNull keeps the audit row if the rule is deleted.
  senderRuleId      String?
  /// Set on a `restore` row: the `move_to_trash` action it undid.
  undoOfId          String?             @unique
  sourceMailbox     String
  sourceUid         Int
  /// UIDVALIDITY as a decimal string (unsigned 32-bit), like RawEmail.
  sourceUidValidity String?
  destMailbox       String?
  /// Null when the server did not report COPYUID (no UIDPLUS).
  destUid           Int?
  destUidValidity   String?
  /// RFC 5322 Message-ID used to verify identity before moving.
  messageId         String?
  fromAddress       String?
  subject           String?
  /// Gmail X-GM-LABELS at move time. Recorded only; not re-applied on undo.
  gmailLabels       String[]
  error             String?
  undoneAt          DateTime?
  createdAt         DateTime            @default(now())

  /// Restrict: an account with mailbox-write history cannot be deleted,
  /// so the audit trail survives.
  account    EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rawEmail   RawEmail?      @relation(fields: [rawEmailId], references: [id], onDelete: SetNull)
  senderRule SenderRule?    @relation(fields: [senderRuleId], references: [id], onDelete: SetNull)
  undoOf     MailboxAction? @relation("MailboxActionUndo", fields: [undoOfId], references: [id], onDelete: SetNull)
  undoneBy   MailboxAction? @relation("MailboxActionUndo")
  // Hand-written in migration 20260923162327_mailbox_action_unknown_restrict_one_active
  // (Prisma cannot express partial indexes): at most one active
  // (status NOT IN failed/skipped/undone) move_to_trash per
  // (accountId, sourceUidValidity, sourceUid) and per rawEmailId.

  @@index([accountId, createdAt])
  @@index([rawEmailId])
  @@index([senderRuleId])
  @@index([status])
  @@index([accountId, messageId])
}

enum ClassificationRevisionAction {
  update
  claim
  release
}

enum ClassificationRevisionStatus {
  /// update/claim: the new values were written.
  applied
  /// release: row deleted and the email classified again in the same request.
  reclassified
  /// release: row deleted; classification failed or the AI breaker was
  /// open, so the email is unclassified until the next classification run.
  deferred
  /// release with release=mark_review: row kept, needsReview set.
  marked_review
}

/// Audit log of every classification change made by
/// POST /sender-rules/:id/reclassify. One row per change, written in the
/// same transaction as the change. Undone per batch.
model ClassificationRevision {
  id                String                       @id @default(cuid())
  batchId           String
  action            ClassificationRevisionAction
  status            ClassificationRevisionStatus
  normalizedEmailId String
  /// EmailClassification.id at the time of the change. No FK: a release
  /// deletes that row.
  classificationId  String?
  /// The rule being reclassified. SetNull keeps the audit row if the rule
  /// is deleted.
  senderRuleId      String?
  /// Full previous values (category, importance, urgency,
  /// recommendedAction, confidence, needsReview, reason, providerUsed,
  /// senderRuleId, rawResponse, classificationError).
  previous          Json
  /// Values after the change, same shape. Null for a deferred release.
  next              Json?
  undoneAt          DateTime?
  createdAt         DateTime                     @default(now())

  normalizedEmail NormalizedEmail @relation(fields: [normalizedEmailId], references: [id], onDelete: Cascade)
  senderRule      SenderRule?     @relation(fields: [senderRuleId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([normalizedEmailId])
  @@index([senderRuleId])
  @@index([createdAt])
}

model ReviewDecision {
  id                String             @id @default(cuid())
  classificationId  String             @unique
  decision          ReviewDecisionType
  correctedCategory String?
  decidedAt         DateTime           @default(now())

  classification EmailClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  @@index([decision])
  @@index([decidedAt])
}

model AiProviderConfig {
  id          String   @id @default(cuid())
  provider    String
  apiKey      String
  apiEndpoint String?
  model       String
  temperature Float    @default(0.3)
  maxTokens   Int      @default(1000)
  isActive    Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider])
  @@index([isActive])
  @@index([isEnabled])
}

model EmailMessage {
  id           String    @id @default(cuid())
  accountId    String
  mailbox      String    @default("INBOX")
  uid          Int
  messageId    String?
  subject      String?
  fromAddress  String
  fromName     String?
  date         DateTime?
  body         String
  flags        String[]
  internalDate DateTime
  createdAt    DateTime  @default(now())

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, mailbox, uid])
  @@index([accountId, date])
}

enum ReviewDecisionType {
  approved
  rejected
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
}
