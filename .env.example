# Copy to .env and fill in values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://email_ai:email_ai_dev@localhost:5432/email_ai

# HTTP port (default: 3000)
PORT=3000

# AES-256-GCM key for encrypting stored IMAP passwords.
# Any string works; it is SHA-256 hashed internally to 32 bytes.
# Generate a strong value: openssl rand -hex 32
ENCRYPTION_KEY=change-me-before-use-generate-with-openssl-rand

# development | test | production
NODE_ENV=development

# Max AI provider calls per minute (default: 20). Raise for gateways
# with generous limits, e.g. 120 for OpenCode Zen with small models.
AI_REQUESTS_PER_MINUTE=20

# Output token ceiling per classification call (default: 4000).
# Reasoning models (gpt-5 family) consume hidden thinking tokens from
# this budget; too low truncates the JSON response.
AI_MAX_TOKENS=4000

# Base URL used for approve/reject links in digest markdown
# (default: http://localhost:$PORT)
# DIGEST_LINK_BASE_URL=http://localhost:3000

# Google OAuth for Gmail accounts (XOAUTH2). Optional — app runs without.
# Reuse an existing GCP project's OAuth client (e.g. the qi calendar one):
#   - Add the Gmail scope (https://mail.google.com/) to the consent screen.
#   - Set consent screen publishing status to "In production"; in "Testing"
#     status refresh tokens expire after 7 days.
#   - "Web application" client type: register the exact redirect URI below
#     as an authorized redirect URI. "Desktop" type: any localhost works.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx

# Redirect URI override; must exactly match the GCP-registered URI.
# (default: http://localhost:$PORT/email-accounts/oauth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3000/email-accounts/oauth/google/callback
